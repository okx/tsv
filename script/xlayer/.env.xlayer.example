# Copy to .env.xlayer and set your own operator wallet key.
# The operator loads this file automatically. Keep the real file local and uncommitted.
XLAYER_PRIVATE_KEY=""

# Required only for DexRouter + TSVAdapter swaps. Must derive the address returned by
# TSVAdapter.AUTH_SIGNER() on the deployed signed-amount adapter.
TSV_SWAP_AUTH_SIGNER_PRIVATE_KEY=""
